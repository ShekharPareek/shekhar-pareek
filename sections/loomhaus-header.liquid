{{ 'loomhaus-base.css' | asset_url | stylesheet_tag }}
{{ 'loomhaus-header.css' | asset_url | stylesheet_tag }}

<header
  class="lh-section lh-header"
  style="
    --lh-header-bg: {{ section.settings.bg_color }};
    --lh-header-text: {{ section.settings.text_color }};
    --lh-header-btn-bg: {{ section.settings.button_bg }};
    --lh-header-btn-text: {{ section.settings.button_text_color }};
    --lh-header-count-bg: {{ section.settings.count_bg }};
  "
  {{ section.shopify_attributes }}
>
  <div class="lh-header__inner">
    <a class="lh-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag:
          width: section.settings.logo_width,
          alt: shop.name,
          loading: 'eager' }}
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name }}
      {%- endif -%}
    </a>

    {%- if section.settings.tagline != blank -%}
      <p class="lh-header__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}

    <div class="lh-header__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="lh-header__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
          <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
            <path d="M1 6h14M10 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

     <button type="button" class="lh-header__cart" data-lh-cart-open aria-label="Open cart">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M5 8h14l-1 12H6L5 8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
  <span class="lh-header__count" data-lh-cart-count {% if cart.item_count < 1 %}hidden{% endif %}>{{ cart.item_count }}</span>
</button>
    </div>
  </div>
</header>

<script src="{{ 'loomhaus-header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Loomhaus header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 10, "unit": "px", "default": 120 },
    { "type": "text", "id": "logo_text", "label": "Logo text (used if no image)", "default": "Loomhaus" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "tagline", "label": "Header text", "default": "Clothes made to be worn for years, not seasons." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F6F1E7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#292A26" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#E6DFD0" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#292A26" },
    { "type": "color", "id": "count_bg", "label": "Cart count badge", "default": "#6B6F4E" }
  ],
  "presets": [
    { "name": "Loomhaus header" }
  ]
}
{% endschema %}