
{{ 'loomhaus-base.css' | asset_url | stylesheet_tag }}
{{ 'loomhaus-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'loomhaus-quick-view.css' | asset_url | stylesheet_tag }}

<section
  class="lh-section lh-grid"
  style="--lh-grid-bg: {{ section.settings.bg_color }};"
  {{ section.shopify_attributes }}
>
  <div class="lh-grid__inner">

    <div class="lh-grid__head">
      <div>
        {% if section.settings.label != blank %}
          <p class="lh-grid__label">
            {{ section.settings.label }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="lh-grid__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>

      {% if section.settings.note != blank %}
        <p class="lh-grid__note">
          {{ section.settings.note }}
        </p>
      {% endif %}
    </div>

    <ul class="lh-grid__tiles">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% assign tile_image = block.settings.image %}

        <li
          class="lh-grid__tile"
          {{ block.shopify_attributes }}
        >
          <div class="lh-grid__media">

            {% if tile_image != blank %}
              {{
                tile_image
                | image_url: width: 1200
                | image_tag:
                  widths: '300, 450, 600, 900, 1200',
                  sizes: '(min-width: 990px) 30vw, 50vw',
                  alt: tile_image.alt | default: 'Shop the look',
                  loading: 'lazy',
                  class: 'lh-grid__img'
              }}
            {% else %}
              {{
                'collection-1'
                | placeholder_svg_tag: 'lh-grid__img'
              }}
            {% endif %}

            {% if product != blank %}

             

{% assign product_1 = block.settings.product %}
{% assign product_2 = block.settings.product_2 %}

{% if product_1 != blank %}
  <button
    type="button"
    class="lh-grid__hotspot lh-grid__hotspot--1"
    style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;"
    data-lh-quickview
    data-handle="{{ product_1.handle }}"
    aria-label="Quick view {{ product_1.title | escape }}"
  >
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="lh-grid__pill lh-grid__pill--1">
    <span>{{ product_1.title }}</span>
    <strong>{{ product_1.price | money }}</strong>
  </div>
{% endif %}


{% if product_2 != blank %}
  <button
    type="button"
    class="lh-grid__hotspot lh-grid__hotspot--2"
    style="left: {{ block.settings.hotspot_x_2 }}%; top: {{ block.settings.hotspot_y_2 }}%;"
    data-lh-quickview
    data-handle="{{ product_2.handle }}"
    aria-label="Quick view {{ product_2.title | escape }}"
  >
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="lh-grid__pill lh-grid__pill--2">
    <span>{{ product_2.title }}</span>
    <strong>{{ product_2.price | money }}</strong>
  </div>
{% endif %}

{% if product_1 == blank and product_2 == blank %}
  <div class="lh-grid__empty">Select a product</div>
{% endif %}

          </div>
        </li>
      {% endfor %}
    </ul>

  </div>
</section>

{% schema %}
{
  "name": "Loomhaus product grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Heading row"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loomhaus in the wild"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Right side text",
      "default": "Tap the + on any look to shop it."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F6F1E7"
    }
  ],
 
"blocks": [
  {
    "type": "tile",
    "name": "Image with products",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Tile image"
      },
      {
        "type": "header",
        "content": "Hotspot 1"
      },
      {
        "type": "product",
        "id": "product",
        "label": "Select product 1"
      },
      {
        "type": "range",
        "id": "hotspot_x",
        "label": "Product 1: Left",
        "min": 5,
        "max": 95,
        "step": 1,
        "unit": "%",
        "default": 50
      },
      {
        "type": "range",
        "id": "hotspot_y",
        "label": "Product 1: Top",
        "min": 5,
        "max": 95,
        "step": 1,
        "unit": "%",
        "default": 40
      },
      {
        "type": "header",
        "content": "Hotspot 2"
      },
      {
        "type": "product",
        "id": "product_2",
        "label": "Select product 2"
      },
      {
        "type": "range",
        "id": "hotspot_x_2",
        "label": "Product 2: Left",
        "min": 5,
        "max": 95,
        "step": 1,
        "unit": "%",
        "default": 70
      },
      {
        "type": "range",
        "id": "hotspot_y_2",
        "label": "Product 2: Top",
        "min": 5,
        "max": 95,
        "step": 1,
        "unit": "%",
        "default": 60
      }
    ]
  }
],

  "presets": [
    {
      "name": "Loomhaus product grid",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}

<script src="{{ 'loomhaus-quick-view.js' | asset_url }}" defer></script>