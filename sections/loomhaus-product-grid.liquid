{{ 'loomhaus-base.css' | asset_url | stylesheet_tag }}
{{ 'loomhaus-product-grid.css' | asset_url | stylesheet_tag }}


<section
  class="lh-section lh-grid"
  style="--lh-grid-bg: {{ section.settings.bg_color }};"
  {{ section.shopify_attributes }}
>
  <div class="lh-grid__inner">

    <div class="lh-grid__head">
      <div>
        {%- if section.settings.label != blank -%}
          <p class="lh-grid__label">{{ section.settings.label }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lh-grid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.note != blank -%}
        <p class="lh-grid__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

   <ul class="lh-grid__tiles">
  {% for product in collections[section.settings.collection].products %}
    <li class="product-item">
      <a href="{{ product.url }}">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 900 | image_tag:
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 990px) 30vw, 50vw',
                alt: product.featured_image.alt | default: product.title,
                loading: 'lazy',
                class: 'lh-grid__img' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'lh-grid__img' }}
           {% endif %}

        <button
              type="button"
              class="lh-grid__hotspot"
              style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;"
              data-lh-quickview
              data-handle="{{ product.handle }}"
              aria-label="Quick view {{ product.title | escape }}"
            >
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>
            <p class="lh-grid__pill">
              <span>{{ product.title }}</span>
              <strong>{{ product.price | money }}</strong>
            </p>
      </a>
    </li>
  {% endfor %}
</ul>

  </div>
</section>

{% schema %}
{
  "name": "Loomhaus product grid",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Heading row" },
    { "type": "text", "id": "label", "label": "Small label", "default": "Shop the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loomhaus in the wild" },
    { "type": "text", "id": "note", "label": "Right side text", "default": "Tap the + on any look to shop it." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F6F1E7" },
    { "type": "header", "content": "Collection" },
    { "type": "collection", "id": "collection", "label": "Collection"   }
  ],
 
  "presets": [
    {
      "name": "Loomhaus product grid",
        "category": "Loomhaus"
    }
  ]
}
{% endschema %}

<script>
      document.addEventListener('click', e => {
    const b = e.target.closest('[data-lh-quickview]');
    if (b) console.log('quick view:', b.dataset.handle);
  });
</script>